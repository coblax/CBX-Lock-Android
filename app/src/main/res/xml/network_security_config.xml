<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain http is allowed: an exam on a school's own http server still opens, and the
         student is warned that the connection is not encrypted. The domain list this
         replaced named IP ranges ("192.168.0.0"), which Android matches as literal host
         names, so it never let a school server through. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Let's Encrypt roots, for exam servers using its certificates. Android 7.0
                 ships neither, so the exam page failed there with a certificate error.
                 X2 also covers servers that send the short ECDSA chain without its X1
                 cross-sign, which Android 7.1-13 cannot verify on their own. -->
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
